void setup() 
{
  pinMode(3, OUTPUT) ;
  pinMode(2, INPUT) ;

  Serial.begin(9600) ;
}

void loop() 
{
  digitalWrite( 3, 0 ) ;
  digitalWrite( 3, 1 ) ;
  delayMicroseconds(10) ;
  digitalWrite( 3, 0 ) ;

 unsigned long echo = pulseIn(2, HIGH) ;
 float diatance = echo * 0.01723 ;
 Serial.println(diatance) ;

}
